# Only the SSH module’s declared source files and ciphertext belong here.
/modules/applications/openssh/*
!/modules/applications/openssh/default.nix
!/modules/applications/openssh/darwin.nix
!/modules/applications/openssh/ssh-keys.py
!/modules/applications/openssh/config
!/modules/applications/openssh/hosts.config
!/modules/applications/openssh/known-hosts.nix
!/modules/applications/openssh/known_hosts
!/modules/applications/openssh/*.pub
!/modules/applications/openssh/ssh-keys.age
__pycache__/

# Local development state; devenv.lock is versioned.
/.devenv/
/devenv.local.nix
/devenv.local.yaml
.ruff_cache/
