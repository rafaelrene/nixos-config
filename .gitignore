# Only the SSH module’s declared source files and ciphertext belong here.
/modules/services/ssh/*
!/modules/services/ssh/default.nix
!/modules/services/ssh/ssh-keys.py
!/modules/services/ssh/config
!/modules/services/ssh/hosts.config
!/modules/services/ssh/*.pub
!/modules/services/ssh/ssh-keys.age
!/modules/services/ssh/README.md
__pycache__/

# Local development state; devenv.lock is versioned.
/.devenv/
/.direnv/
/devenv.local.nix
/devenv.local.yaml
.ruff_cache/
