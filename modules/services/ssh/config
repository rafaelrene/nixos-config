# This file is linked from ~/.ssh/config. Edits there are edits to this checkout.
Include /data/code/nixos-config/modules/services/ssh/hosts.config

# Keep defaults last: OpenSSH uses the first value found for each option.
Host *
  # Use the NixOS agent even in processes started before the agent migration.
  IdentityAgent /run/user/1000/ssh-agent
