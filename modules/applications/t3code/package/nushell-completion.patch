--- a/desktop/apps/server/dist/binCli.mjs
+++ b/desktop/apps/server/dist/binCli.mjs
@@ -212185,6 +212185,7 @@
 	const shell = env.SHELL ?? "";
 	const name = shell.split("/").at(-1) ?? shell;
 	if (name === "fish") return "fish";
+	if (name === "nu") return "nushell";
 	if (name === "pwsh" || name === "powershell") return "powershell";
 	return "posix";
 }
@@ -212201,6 +212202,9 @@
 	switch (shell) {
 		case "powershell": return `$global:LASTEXITCODE = $null; & {\r${body}\r}; if ($null -ne $LASTEXITCODE) { $__t3c = $LASTEXITCODE } elseif ($?) { $__t3c = 0 } else { $__t3c = 1 }; Write-Host "${sentinel}$__t3c"`;
 		case "fish": return `begin\r${body}\rend; printf '\\n${sentinel}%s\\n' $status`;
+		// Nushell aborts on a failed external command; catch must report its exit code.
+		case "nushell":
+			return `let __t3c = try {\r${body}\r0\r} catch {|e| $e.exit_code? | default 1 }; print $"\\n${sentinel}($__t3c)"`;
 		case "posix": return `( ${body}\r); printf '\\n${sentinel}%s\\n' "$?"`;
 	}
 }
