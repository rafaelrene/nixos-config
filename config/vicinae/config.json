{
  "$schema": "https://vicinae.com/schemas/config.json",
  "telemetry": {
    "system_info": false
  },
  "input_server": {
    "enabled": false
  },
  "search_files_in_root": false,
  "close_on_focus_loss": false,
  "font": {
    "rendering": "native",
    "normal": {
      "family": "JetBrainsMono Nerd Font"
    }
  },
  "theme": {
    "light": {
      "name": "catppuccin-mocha",
      "icon_theme": "breeze-dark"
    },
    "dark": {
      "name": "catppuccin-mocha",
      "icon_theme": "breeze-dark"
    }
  }
}
